# Gruvbox Material Dark Hard — Ghostty
#
# Translated 1:1 from kitty/.config/kitty/Gruvbox Material Dark Hard.conf so both
# terminals render identically. Do NOT replace this with Ghostty's built-in
# "Gruvbox Material Dark" theme (Contents/Resources/ghostty/themes/) — that is the
# MEDIUM variant: background #282828, palette 3 #d8a657, palette 8 #7c6f64.
#
# Cross-tool invariant: palette 3 (#e78a4e) is the same orange as JankyBorders'
# active_color (0xFFE78A4E) and SketchyBar's $ACCENT. Background #1d2021 is
# SketchyBar's bar background. Changing either desyncs the bar and the borders.
#
# name: Gruvbox Material Dark Hard
# author: Sainnhe Park
# license: MIT
# upstream: https://github.com/rsaihe/gruvbox-material-kitty

background = #1d2021
foreground = #d4be98

selection-background = #d4be98
selection-foreground = #1d2021

# kitty had `cursor_text_color background`, which resolves to the background above.
cursor-color = #7daea3
cursor-text = #1d2021

# black
palette = 0=#665c54
palette = 8=#928374

# red
palette = 1=#ea6962
palette = 9=#ea6962

# green
palette = 2=#a9b665
palette = 10=#a9b665

# yellow — 3 is the orange accent shared with borders/sketchybar, 11 the true yellow
palette = 3=#e78a4e
palette = 11=#d8a657

# blue
palette = 4=#7daea3
palette = 12=#7daea3

# magenta
palette = 5=#d3869b
palette = 13=#d3869b

# cyan
palette = 6=#89b482
palette = 14=#89b482

# white
palette = 7=#d4be98
palette = 15=#d4be98
